{
  "name": "pharmassistant",
  "version": "1.0.0",
  "description": "Client JavaScript et TypeScript officiel de l'API PharmAssistant, l'assistant pharmaceutique de l'officine : réponses typées, flux, conversations, citations, erreurs typées.",
  "keywords": [
    "pharmassistant",
    "pharmacie",
    "officine",
    "pharmacien",
    "api",
    "client",
    "sdk"
  ],
  "homepage": "https://github.com/Vitruves/pharmassistant-js#readme",
  "bugs": "https://github.com/Vitruves/pharmassistant-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vitruves/pharmassistant-js.git"
  },
  "license": "MIT",
  "author": "PharmAssistant",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contrat": "PHARMASSISTANT_CONTRAT=1 vitest run test/contrat.test.ts",
    "verifier": "npm run typecheck && npm test && npm run build && publint && attw --pack .",
    "prepublishOnly": "npm run verifier"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.7",
    "esbuild": "^0.27.7",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "vitest": "^4.1.12"
  }
}
